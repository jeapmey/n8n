        -288
      ],
      "id": "2f97e1e5-cfdd-4092-bce2-e7b8470709ce",
      "name": "Xero - Check Existing Bill"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "0dc56eae-fa46-46d2-ac55-4a9f97353818",
              "leftValue": "={{ Array.isArray($json.Invoices) && !$json.Invoices.some(bill => bill.Contact?.ContactID === $('Match Xero Supplier').first().json.xero_contact_id) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
