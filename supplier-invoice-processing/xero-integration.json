      "id": "e04c5bc7-cac9-42c3-be85-e1d0f5df1e99",
      "name": "Bill Can Be Created?"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "https://api.xero.com/api.xro/2.0/Invoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
