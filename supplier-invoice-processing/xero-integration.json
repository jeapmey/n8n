      ],
      "id": "5ee1f67b-c60d-4786-be2b-6177dffa4447",
      "name": "Xero - Get Contacts"
    },
    {
      "parameters": {
        "jsCode": "const invoice = $('When Executed by Another Workflow')\n  .first().json;\n\nconst contacts = $input.all().flatMap(\n  item => item.json.Contacts || []\n);\n\nconst normalize = value =>\n  String(value || '').trim().toLowerCase();\n\nconst matches = contacts.filter(contact =>\n  contact.ContactStatus === 'ACTIVE' &&\n  normalize(contact.Name) ===\n  normalize(invoice.supplier_name)\n);\n\nconst supplier = matches.length === 1\n  ? matches[0]\n  : null;\n\nreturn [{\n  json: {\n    ...invoice,\n    xero_contact_id: supplier?.ContactID || null,\n    xero_contact_name: supplier?.Name || null,\n    supplier_match_status:\n      matches.length === 1 ? 'matched' :\n      matches.length > 1 ? 'ambiguous' :\n      'not_found'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        -192
      ],
      "id": "9d8a9046-2828-43b1-a2a2-5b2ad7d18ec4",
      "name": "Match Xero Supplier"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "6d32476e-11e6-4bd0-a24c-c8b3d996fedb",
              "leftValue": "={{ $json.supplier_match_status === 'matched' && $json.approval_status === 'approved' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1056,
        -192
      ],
      "id": "8ff234fd-0a04-49f1-8aa8-23bd0cd90b5b",
      "name": "Supplier Matched?"
    },
