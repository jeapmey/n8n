      "id": "7ad88915-63a0-498a-9011-898eaa8d25fa",
      "name": "Xero - Create Draft Bill"
    },
    {
      "parameters": {
        "jsCode": "const invoice = $('Match Xero Supplier').first().json;\nconst bill = $input.first().json.Invoices?.[0];\n\nif (!bill?.InvoiceID || bill.HasErrors || bill.Status !== 'DRAFT') {\n  throw new Error('Xero draft bill creation could not be verified');\n}\n\nreturn [{\n  json: {\n    ...invoice,\n    accounting_platform: 'Xero',\n    accounting_status: 'draft_created',\n    xero_invoice_id: bill.InvoiceID,\n    xero_invoice_status: bill.Status,\n    xero_invoice_number: bill.InvoiceNumber,\n    xero_total_amount: bill.Total,\n    accounting_processed_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        -384
      ],
      "id": "7d0c9de7-1b7a-4c9b-ba17-3b9cab733637",
      "name": "Return Created Bill"
    },
    {
      "parameters": {
        "jsCode": "const invoice = $('Match Xero Supplier').first().json;\n\nconst bill = $input.first().json.Invoices?.find(\n  item => item.Contact?.ContactID === invoice.xero_contact_id\n);\n\nif (!bill?.InvoiceID) {\n  throw new Error('Existing Xero bill could not be verified');\n}\n\nreturn [{\n  json: {\n    ...invoice,\n    accounting_platform: 'Xero',\n    accounting_status: 'already_exists',\n    xero_invoice_id: bill.InvoiceID,\n    xero_invoice_status: bill.Status,\n    xero_invoice_number: bill.InvoiceNumber,\n    xero_total_amount: bill.Total,\n    accounting_processed_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1952,
        -192
      ],
      "id": "b6d66455-feee-4563-a98c-2e0fab8e6b71",
      "name": "Return Existing Bill"
    },
    {
      "parameters": {
        "jsCode": "const invoice = $input.first().json;\n\nreturn [{\n  json: {\n    ...invoice,\n    accounting_platform: 'Xero',\n    accounting_status: 'review_required',\n    accounting_error:\n      invoice.approval_status !== 'approved'\n        ? 'Invoice has not been approved'\n        : 'Supplier could not be uniquely matched in Xero',\n    xero_invoice_id: null,\n    xero_invoice_status: null,\n    accounting_processed_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -96
      ],
      "id": "856bd49c-176c-4859-915c-f30c54408b29",
      "name": "Return Accounting Exception"
    },
    {
      "parameters": {
        "jsCode": "const invoice = $('Match Xero Supplier').first().json;\n\nif (!Array.isArray(invoice.line_items) || !invoice.line_items.length) {\n  throw new Error('No invoice line items available');\n}\n\nif (invoice.vat_amount !== null && invoice.vat_amount !== 0) {\n  throw new Error('VAT treatment requires review');\n}\n\nconst accounts = $('Xero - Get Accounts').first().json.Accounts;\n\nconst account = accounts.find(a =>\n  a.Code === '412' &&\n  a.Status === 'ACTIVE' &&\n  a.Class === 'EXPENSE'\n);\n\nif (!account) {\n  throw new Error('Configured expense account unavailable');\n}\n\nconst lineItems = invoice.line_items.map(item => {\n  if (\n    !item.description ||\n    !Number.isFinite(item.quantity) ||\n    item.quantity <= 0 ||\n    !Number.isFinite(item.unit_price) ||\n    item.unit_price < 0\n  ) {\n    throw new Error('Invalid invoice line item');\n  }\n\n  return {\n    Description: item.description,\n    Quantity: item.quantity,\n    UnitAmount: item.unit_price,\n    AccountCode: account.Code,\n    TaxType: 'NONE'\n  };\n});\n\nconst calculatedTotal = lineItems.reduce(\n  (sum, item) => sum +\n    Math.round(item.Quantity * item.UnitAmount * 100),\n  0\n);\n\nif (calculatedTotal !== Math.round(invoice.total_amount * 100)) {\n  throw new Error('Line items do not match invoice total');\n}\n\nreturn [{\n  json: {\n    Invoices: [{\n      Type: 'ACCPAY',\n      Contact: {\n        ContactID: invoice.xero_contact_id\n      },\n      InvoiceNumber: invoice.invoice_number,\n      Date: invoice.invoice_date,\n      DueDate: invoice.due_date,\n      CurrencyCode: invoice.currency,\n      Status: 'DRAFT',\n      LineAmountTypes: 'NoTax',\n      LineItems: lineItems\n    }]\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1952,
        -384
      ],
      "id": "53c4254b-57fc-4b72-bf9c-3652ea21136c",
      "name": "Prepare Xero Bill"
    }
  ],
