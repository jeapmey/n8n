      "name": "Xero - Get Accounts"
    },
    {
      "parameters": {
        "url": "https://api.xero.com/api.xro/2.0/Invoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "where",
              "value": "={{ 'Type==\"ACCPAY\" AND InvoiceNumber==' + JSON.stringify($('Match Xero Supplier').first().json.invoice_number) }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
